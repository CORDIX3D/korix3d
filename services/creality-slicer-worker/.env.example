# Połączenie z wdrożoną aplikacją
KORIX3D_SITE_URL=https://korix3d.pl
CREALITY_SLICER_WORKER_PRIVATE_KEY_PATH=C:\KORIX3D\secrets\worker-private-key.pem

# Lokalna instalacja Creality Print i jawna tablica argumentów CLI
CREALITY_PRINT_BIN=C:\Program Files\Creality\Creality Print 7.1\CrealityPrint.exe
CREALITY_MACHINE_PROFILE_PATH=C:\Program Files\Creality\Creality Print 7.1\resources\profiles\Creality\machine\Creality Ender-3 V3 Plus 0.4 nozzle.json
CREALITY_PROCESS_PROFILE_PATH=C:\Program Files\Creality\Creality Print 7.1\resources\profiles\Creality\process\0.20mm Standard @Creality Ender-3 V3 Plus 0.4 nozzle.json
CREALITY_FILAMENT_PROFILES_JSON={"PLA":"C:\\Program Files\\Creality\\Creality Print 7.1\\resources\\profiles\\Creality\\filament\\Generic PLA @Creality Ender-3 V3 Plus 0.4 nozzle.json","PETG":"C:\\Program Files\\Creality\\Creality Print 7.1\\resources\\profiles\\Creality\\filament\\Generic PETG @Creality Ender-3 V3 Plus 0.4 nozzle.json"}

# Profile i identyfikacja workera
SLICER_WORKER_ID=creality-production-1
CREALITY_PRINT_VERSION=7.1
CREALITY_PRINTER_PROFILE=Creality Ender-3 V3 Plus 0.4 nozzle
CREALITY_PROCESS_PROFILE=0.20mm Standard

# Opcjonalne limity (wartości domyślne: 5000, 720000 i 60000 ms)
SLICER_POLL_INTERVAL_MS=5000
SLICER_JOB_TIMEOUT_MS=720000
SLICER_HTTP_TIMEOUT_MS=60000
SLICER_DASHBOARD_PORT=4317
