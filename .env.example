# === PUBLIC ===
# Kanoniczny adres aplikacji. Produkcja używa dokładnie domeny bez www i bez ukośnika na końcu.
NEXT_PUBLIC_SITE_URL=https://korix3d.pl

# === SEO ===
# Opcjonalne publiczne tokeny weryfikacyjne. Nie są sekretami.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# === SERVER ===
# NODE_ENV, VERCEL, VERCEL_ENV i VERCEL_GIT_COMMIT_SHA ustawia platforma.
# Nie dodawaj własnych sekretów z prefiksem NEXT_PUBLIC_.

# === SUPABASE ===
# Project URL oraz publiczny klucz anon/publishable z Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role/secret wyłącznie dla funkcji serwerowych Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# === STRIPE ===
# Ograniczony klucz rk_test_ na stagingu lub rk_live_ na produkcji (preferowany);
# standardowy sk_ jest akceptowany wyłącznie, gdy ograniczenie uprawnień nie jest możliwe.
STRIPE_SECRET_KEY=
# Sekret podpisu endpointu https://korix3d.pl/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# === SMTP ===
# Ta sama skrzynka firmowa obsługuje Supabase Auth oraz linki powrotu do płatności.
# Dane serwera i portu podaje operator skrzynki. Dla portu 465 aplikacja używa TLS,
# a dla pozostałych portów wymusza STARTTLS. Wszystkie wartości są sekretami serwera.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# === AI ===
# Brak zmiennych. KORIX AI działa lokalnie i nie używa OpenAI ani płatnego API.

# === UPLOAD ===
# Brak dodatkowych zmiennych. Prywatne uploady korzystają z Supabase Storage,
# Project URL i kluczy Supabase z sekcji powyżej; buckety tworzą migracje.

# === CREALITY ===
# Publiczna część klucza Ed25519 workera w formacie PEM. Prywatny klucz pozostaje
# wyłącznie na hoście Windows i nigdy nie trafia do Vercel ani repozytorium.
CREALITY_SLICER_WORKER_PUBLIC_KEY=
# Ustawienia procesu i prywatnego klucza znajdują się w services/creality-slicer-worker/.env.example.

# === MONITORING ===
# Losowy sekret (minimum 32 znaki) chroniący wewnętrzny przegląd stanu uruchamiany przez Vercel Cron.
CRON_SECRET=
# Brak zewnętrznego, płatnego dostawcy. Błędy trafiają do ustrukturyzowanych
# logów Vercel, a aplikacja udostępnia /api/health i chronione /api/admin/health.

# === ANALYTICS ===
# Brak zewnętrznego trackera w MVP; aplikacja nie wysyła danych klientów do analityki.
# Vercel Web Analytics można włączyć później po decyzji właściciela i aktualizacji polityki prywatności.

# === CACHE ===
# Brak zewnętrznego Redis/KV. Cache statycznych zasobów i obrazów obsługują Next.js oraz Vercel CDN.
