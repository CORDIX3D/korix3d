{
  "name": "korix3d",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:prebuilt": "node scripts/run-e2e.mjs --prebuilt",
    "test:production:smoke": "playwright test --config playwright.production.config.ts",
    "test:rls:db": "supabase test db --local",
    "test:smoke": "node scripts/smoke-built-app.mjs",
    "check:db": "node scripts/check-migrations.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:supabase": "npm run check:db && npm run check:rls && node scripts/check-supabase-production.mjs",
    "check:stripe": "node scripts/check-stripe-production.mjs",
    "check:vercel": "node scripts/check-vercel-production.mjs",
    "check:domain": "node scripts/check-domain-production.mjs",
    "check:monitoring": "node scripts/check-monitoring-production.mjs",
    "check:backup": "node scripts/check-backup-production.mjs",
    "check:worker": "node scripts/check-worker-production.mjs",
    "check:production-tests": "node scripts/check-production-test-plan.mjs",
    "check:performance": "node scripts/check-performance-production.mjs",
    "check:seo": "node scripts/check-seo-production.mjs",
    "check:security": "node scripts/check-security-production.mjs",
    "check:production-report": "node scripts/check-production-ready-report.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:env": "node scripts/check-env-contract.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run check:secrets && npm run check:env && npm run lint && npm run typecheck && npm test && npm run check:supabase && npm run check:stripe && npm run check:vercel && npm run check:domain && npm run check:monitoring && npm run check:backup && npm run check:worker && npm run check:production-tests && npm run check:performance && npm run check:seo && npm run check:security && npm run check:production-report && npm run check:docs && npm run build && npm run check:bundle && npm run test:smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "1.4.2",
    "lucide-react": "^0.446.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "2.1.9",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.5.2",
    "vaul": "1.1.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "$postcss",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next": {
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.21",
    "@playwright/test": "^1.62.0",
    "@types/node": "20.19.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.15",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.23",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.2.2",
    "vitest": "^3.2.6"
  }
}
