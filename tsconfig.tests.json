{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "lib/cart.ts",
    "lib/accounting/product-ranking.ts",
    "lib/discount.ts",
    "lib/shipping.ts",
    "lib/checkout-token.ts",
    "lib/order-3d-status.ts",
    "lib/quote-files.ts",
    "lib/product-validation.ts",
    "lib/store-order-validation.ts",
    "lib/supabase/client.ts",
    "lib/types/database.ts",
    "tests/core.test.ts"
  ]
}
