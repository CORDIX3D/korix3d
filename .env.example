# Publiczne — mogą znaleźć się w kodzie przeglądarki
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://korix3d.pl

# Serwerowe — nigdy nie używaj prefiksu NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — wyłącznie klucze serwerowe i sekret podpisu webhooka
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zdalny slicer — ten sam losowy sekret musi mieć worker
CREALITY_SLICER_WORKER_TOKEN=

# Storage korzysta z konfiguracji Supabase powyżej.
# KORIX AI nie wymaga klucza zewnętrznego ani płatnego API.
# E-mail i monitoring nie mają obecnie zewnętrznego dostawcy.
