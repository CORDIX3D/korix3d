# === PUBLIC ===
# Kanoniczny adres aplikacji. Produkcja używa dokładnie domeny bez www i bez ukośnika na końcu.
NEXT_PUBLIC_SITE_URL=https://korix3d.pl

# === SERVER ===
# NODE_ENV, VERCEL, VERCEL_ENV i VERCEL_GIT_COMMIT_SHA ustawia platforma.
# Nie dodawaj własnych sekretów z prefiksem NEXT_PUBLIC_.

# === SUPABASE ===
# Project URL oraz publiczny klucz anon/publishable z Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role/secret wyłącznie dla funkcji serwerowych Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# === STRIPE ===
# Serwerowy klucz sk_test_ na stagingu lub sk_live_ na produkcji.
STRIPE_SECRET_KEY=
# Sekret podpisu endpointu https://korix3d.pl/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# === SMTP ===
# Aplikacja nie wysyła poczty przez własny SMTP. Wiadomości logowania i resetu
# obsługuje Supabase Auth; jego dostawcę SMTP konfiguruje się w panelu Supabase.

# === AI ===
# Brak zmiennych. KORIX AI działa lokalnie i nie używa OpenAI ani płatnego API.

# === UPLOAD ===
# Brak dodatkowych zmiennych. Prywatne uploady korzystają z Supabase Storage,
# Project URL i kluczy Supabase z sekcji powyżej; buckety tworzą migracje.

# === CREALITY ===
# Ten sam losowy sekret (minimum 32 znaki) musi być ustawiony na Vercelu i workerze.
CREALITY_SLICER_WORKER_TOKEN=
# Pozostałe ustawienia procesu znajdują się w services/creality-slicer-worker/.env.example.

# === MONITORING ===
# Brak zewnętrznego klucza. Błędy trafiają do ustrukturyzowanych logów Vercel,
# a aplikacja udostępnia /api/health i chronione /api/admin/health.

# === ANALYTICS ===
# Brak zewnętrznego trackera w MVP; aplikacja nie wysyła danych klientów do analityki.
# Vercel Web Analytics można włączyć później po decyzji właściciela i aktualizacji polityki prywatności.

# === CACHE ===
# Brak zewnętrznego Redis/KV. Cache statycznych zasobów i obrazów obsługują Next.js oraz Vercel CDN.
